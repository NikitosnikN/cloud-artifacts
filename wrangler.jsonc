{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-artifacts",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "artifacts.nikitayugov.com", "custom_domain": true }
  ],
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "cloud-artifacts" }
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "MAX_HTML_BYTES": "2097152",
    "MAX_TTL_SECONDS": "31536000",
    "PUBLIC_BASE_URL": "https://artifacts.nikitayugov.com",
    // Exact IPv4 and/or IPv6 agent egress addresses allowed to use REST and MCP uploads.
    "UPLOAD_ALLOWED_IPS": ["31.172.68.213"]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  }
}
